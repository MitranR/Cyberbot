{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/scan", "destination": "/scan.html" },
    { "source": "/volunteers", "destination": "/volunteers.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
